                "$ref": "#/components/schemas/ResendCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification code resent if account exists"
          },
          "400": {
            "description": "Rate limit or already verified"
          }
        },
        "summary": "Resend 6-digit verification code",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/parent/login": {
