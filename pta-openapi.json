          "401": {
            "description": "Invalid credentials or role mismatch"
          },
          "403": {
            "description": "Account pending verification, suspended, or disabled"
          }
        },
        "summary": "Log in as a parent",
        "tags": [
          "Authentication"
        ]
      }
    },
