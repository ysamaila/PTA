  "info": {
    "title": "PTA Authentication API",
    "description": "Authentication Module with Role-Based Access Control and Brevo OTP Verification",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter your JWT access token"
      }
    },
    "schemas": {
      "RegisterParentDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "parent@example.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssword123",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "example": "Sarah Johnson"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "RegisterTeacherDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "teacher@example.com"
          },
          "password": {
            "type": "string",
            "example": "T@acherPass123",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "example": "Mr. David Clark"
          },
          "phone": {
            "type": "string",
            "example": "+1234567891"
          },
          "subjectSpecialization": {
            "type": "string",
            "example": "Mathematics & Science"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "RegisterAdminDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "example": "AdminPass123!",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "example": "System Administrator"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "VerifyCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "Six-digit verification code"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "ResendCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "P@ssword123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Hashed or random refresh token string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "Six-digit password reset verification code"
          },
          "newPassword": {
            "type": "string",
            "example": "NewSecurePassword123!",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "CurrentPassword123!"
          },
          "newPassword": {
            "type": "string",
            "example": "NewSecurePassword123!",
            "minLength": 8
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      }
    }
  }
}